# The gateway reads this value only on the server. Copy to mise.local.toml,
# which is ignored by Git, as DATABENTO_API_KEY = "...".
# Never put the actual key in this file.
DATABENTO_GATEWAY_SOURCE=historical
DATABENTO_LWC_BIND_ADDR=127.0.0.1:8080
DATABENTO_LWC_ALLOWED_ORIGINS=http://127.0.0.1:5173
DATABENTO_LWC_ALLOWED_DATASETS=GLBX.MDP3,XNAS.ITCH
DATABENTO_LWC_ALLOW_UNAUTHENTICATED_LOCALHOST=true
DATABENTO_LWC_AUTH_INTEGRATION_ENABLED=false
DATABENTO_LWC_HISTORY_MAX_INTERVALS=10000
DATABENTO_LWC_SYMBOL_MAX_BYTES=128
DATABENTO_LWC_SYMBOL_SEARCH_MAX_RESULTS=100
DATABENTO_LWC_HTTP_BODY_MAX_BYTES=65536
DATABENTO_LWC_WS_FRAME_MAX_BYTES=65536
DATABENTO_LWC_MAX_CLIENTS=16
DATABENTO_LWC_MAX_SUBSCRIPTIONS_PER_CLIENT=16
DATABENTO_LWC_MAX_DATASET_SESSIONS=4
DATABENTO_LWC_UPSTREAM_QUEUE_CAPACITY=4096
DATABENTO_LWC_CANONICAL_QUEUE_CAPACITY=4096
DATABENTO_LWC_OUTBOUND_QUEUE_CAPACITY=256
DATABENTO_LWC_HANDOFF_BUFFER_CAPACITY=4096
DATABENTO_LWC_RECONNECT_BASE_DELAY_MS=250
DATABENTO_LWC_RECONNECT_MAX_DELAY_MS=8000
DATABENTO_LWC_RECONNECT_MAX_ATTEMPTS=8
