{
  "name": "@lwc-databento/adapter",
  "version": "0.1.0",
  "description": "Framework-neutral Databento history and live-bar provider for Lightweight Charts",
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src test",
    "format:check": "oxfmt --check src test",
    "test": "vitest run",
    "test:contract": "vitest run test/contract"
  },
  "dependencies": {
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "lightweight-charts": "^5.2.1"
  }
}
