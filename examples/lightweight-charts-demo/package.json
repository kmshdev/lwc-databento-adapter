{
  "name": "@lwc-databento/demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src test",
    "format:check": "oxfmt --check src test index.html vite.config.ts",
    "test:e2e": "tsx test/e2e/demo.e2e.ts",
    "test:e2e:local": "tsx test/e2e/local-beta.e2e.ts",
    "test:e2e:live": "tsx test/e2e/live-provider.e2e.ts",
    "test:performance": "tsx test/e2e/performance.e2e.ts"
  },
  "dependencies": {
    "@lwc-databento/adapter": "workspace:*",
    "lightweight-charts": "5.2.1"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "puppeteer": "24.6.1",
    "tsx": "4.20.6",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
